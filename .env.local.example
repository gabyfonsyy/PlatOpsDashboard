# Copy this file to .env.local and fill in your values

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-here  # generate with: openssl rand -base64 32

# Google OAuth (create a NEW OAuth client at console.cloud.google.com — do not reuse Operations Hub's)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google Apps Script Web App (backend — see /gas/README.md)
GAS_WEB_APP_URL=https://script.google.com/macros/s/XXXXXXXX/exec
GAS_API_KEY=your-shared-secret-here   # must match API_SHARED_SECRET in Apps Script properties

# AI (open-weight models on Groq — get a key at console.groq.com/keys). Replaces the old
# GEMINI_API_KEY: the same key now backs the daily narrative insights (gas/AiClient.gs, set it as
# an AI_API_KEY *Script Property* there too) and the interactive incident-feedback rewriting in
# this app (src/lib/ai.ts). Server-only — never prefix it NEXT_PUBLIC_. Without it, the Incident
# Logs page still works for manual entry; only the "Rephrase with AI" button is disabled.
AI_API_KEY=your-groq-api-key-here
# Optional — override the model without a code change. Defaults to llama-3.3-70b-versatile.
# AI_MODEL=llama-3.3-70b-versatile

# Jira (used to build "open in Jira" links — matches the GAS backend's JIRA_BASE_URL script property)
JIRA_BASE_URL=https://sprouthq.atlassian.net

# Supabase (its own project — separate from Operations Hub's Azure Postgres. See supabase/schema.sql
# for the schema and the migration sketch for the phased rollout. Server-only: never prefix these
# with NEXT_PUBLIC_ or use them in client components — every table has RLS enabled with no policies,
# so the service_role key is the only way in.)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here   # Project Settings -> API -> service_role secret
